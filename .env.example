# Site
# Public site URL. Used for SEO: canonical links, Open Graph, JSON-LD.
# Example: https://your-domain.com
NEXT_PUBLIC_SITE_URL=https://xxxx.example

# Contact form (SMTP)
CONTACT_EMAIL=you@example.com
SMTP_USER=you@example.com
# Common typo alias is also read:
# SMPT_USER=you@example.com
SMTP_APP_PASSWORD=your-app-password
# Optional (defaults: Gmail on port 587):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Firebase (Admin SDK — server only)
# From Firebase Console → Project settings → Service accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Keep the \n characters when pasting the private key into one line:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Firebase (web SDK — public, safe in the browser)
# From Firebase Console → Project settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=XXX
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=XX.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=jewelry-project-XXX
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=jewelry-project-XXXX.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=XX
NEXT_PUBLIC_FIREBASE_APP_ID=1:XX:web:XXX
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXX
