# Site
# Public site URL. Used for SEO: canonical links, Open Graph, JSON-LD.
# Example: https://your-domain.com
NEXT_PUBLIC_SITE_URL=https://xxxx.example

# Contact form (SMTP)
CONTACT_EMAIL=you@example.com
SMTP_USER=you@example.com
# Common typo alias is also read:
# SMPT_USER=you@example.com
SMTP_APP_PASSWORD=your-app-password
# Optional (defaults: Gmail on port 587):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Firebase (Admin SDK — server only)
# From Firebase Console → Project settings → Service accounts
FIREBASE_PROJECT_ID=''
FIREBASE_CLIENT_EMAIL=''
# Keep the \n characters when pasting the private key into one line:
FIREBASE_PRIVATE_KEY=""

# Firebase (web SDK — public, safe in the browser)
# From Firebase Console → Project settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=''
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=''
NEXT_PUBLIC_FIREBASE_PROJECT_ID=''
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=''
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=''
NEXT_PUBLIC_FIREBASE_APP_ID=''
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=''
